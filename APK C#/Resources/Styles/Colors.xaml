<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Nota: para Android ver también Platforms\Android\Resources\values\colors.xml -->

    <!-- Paleta institucional I.E. Liceo Trujillo, alineada con I.E. WEB/css/tema.css -->

    <!-- Marca -->
    <Color x:Key="Brand50">#f0f9ff</Color>
    <Color x:Key="Brand100">#e0f2fe</Color>
    <Color x:Key="Brand200">#bae6fd</Color>
    <Color x:Key="Brand400">#38bdf8</Color>
    <Color x:Key="Brand500">#0ea5e9</Color>
    <Color x:Key="Brand600">#0284c7</Color>
    <Color x:Key="Brand700">#0369a1</Color>
    <Color x:Key="Brand800">#075985</Color>
    <Color x:Key="Brand900">#0c4a6e</Color>
    <Color x:Key="Brand950">#082f49</Color>

    <!-- Neutros -->
    <Color x:Key="Neutral0">#ffffff</Color>
    <Color x:Key="Neutral50">#f8fafc</Color>
    <Color x:Key="Neutral100">#f1f5f9</Color>
    <Color x:Key="Neutral200">#e2e8f0</Color>
    <Color x:Key="Neutral300">#cbd5e1</Color>
    <Color x:Key="Neutral400">#94a3b8</Color>
    <Color x:Key="Neutral500">#64748b</Color>
    <Color x:Key="Neutral600">#475569</Color>
    <Color x:Key="Neutral700">#334155</Color>
    <Color x:Key="Neutral900">#0f172a</Color>

    <!-- Estados -->
    <Color x:Key="Success">#10b981</Color>
    <Color x:Key="SuccessDark">#059669</Color>
    <Color x:Key="SuccessLight">#d1fae5</Color>
    <Color x:Key="Danger">#ef4444</Color>
    <Color x:Key="DangerDark">#dc2626</Color>
    <Color x:Key="DangerLight">#fee2e2</Color>
    <Color x:Key="Warning">#f59e0b</Color>
    <Color x:Key="WarningDark">#d97706</Color>
    <Color x:Key="WarningLight">#fef3c7</Color>

    <!-- Tokens semánticos -->
    <Color x:Key="Primary">#0284c7</Color>
    <Color x:Key="PrimaryHover">#0369a1</Color>
    <Color x:Key="PrimaryDark">#0c4a6e</Color>
    <Color x:Key="PrimaryDeep">#082f49</Color>
    <Color x:Key="PrimaryTint">#e0f2fe</Color>
    <Color x:Key="Secondary">#e0f2fe</Color>
    <Color x:Key="Tertiary">#0284c7</Color>

    <Color x:Key="PageBackground">#f8fafc</Color>
    <Color x:Key="Surface">#ffffff</Color>
    <Color x:Key="SurfaceMuted">#f1f5f9</Color>
    <Color x:Key="Outline">#e2e8f0</Color>
    <Color x:Key="OutlineStrong">#cbd5e1</Color>

    <Color x:Key="TextPrimary">#0f172a</Color>
    <Color x:Key="TextSecondary">#475569</Color>
    <Color x:Key="TextMuted">#64748b</Color>
    <Color x:Key="TextPlaceholder">#94a3b8</Color>
    <Color x:Key="TextOnBrand">#ffffff</Color>
    <Color x:Key="TextBrand">#0c4a6e</Color>

    <!-- Aliasing de los nombres originales de la plantilla MAUI -->
    <Color x:Key="White">#ffffff</Color>
    <Color x:Key="Black">#0f172a</Color>
    <Color x:Key="OffBlack">#0f172a</Color>
    <Color x:Key="Magenta">#0284c7</Color>
    <Color x:Key="MidnightBlue">#0c4a6e</Color>
    <Color x:Key="PrimaryDarkText">#0c4a6e</Color>
    <Color x:Key="SecondaryDarkText">#0c4a6e</Color>

    <Color x:Key="Gray100">#f8fafc</Color>
    <Color x:Key="Gray200">#e2e8f0</Color>
    <Color x:Key="Gray300">#cbd5e1</Color>
    <Color x:Key="Gray400">#94a3b8</Color>
    <Color x:Key="Gray500">#64748b</Color>
    <Color x:Key="Gray600">#475569</Color>
    <Color x:Key="Gray900">#0f172a</Color>
    <Color x:Key="Gray950">#0f172a</Color>

    <Color x:Key="Error">#ef4444</Color>
    <Color x:Key="ErrorLight">#fee2e2</Color>

    <!-- Brochas -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="{StaticResource PrimaryDark}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource Outline}" />

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
</ResourceDictionary>
