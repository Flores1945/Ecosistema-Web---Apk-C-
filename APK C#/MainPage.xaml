<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiAppAsistencia.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}"
             Title="Toma de Asistencia">

    <Grid RowDefinitions="Auto,*">

        <!-- ================= Encabezado de marca ================= -->
        <Border Grid.Row="0"
                Background="{StaticResource BrandGradient}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 0,0,26,26"
                Padding="18,26,18,18">
            <VerticalStackLayout Spacing="18">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Grid.Column="0"
                            WidthRequest="46"
                            HeightRequest="46"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="#26FFFFFF"
                            Stroke="#40FFFFFF"
                            StrokeThickness="1"
                            Padding="11">
                        <Image Source="ic_school_white.svg" Aspect="AspectFit" />
                    </Border>

                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="I.E. LICEO TRUJILLO" Style="{StaticResource OverlineOnBrand}" FontSize="10" />
                        <Label Text="Toma de Asistencia"
                               FontFamily="OpenSansSemibold"
                               FontSize="19"
                               TextColor="{StaticResource TextOnBrand}" />
                        <Label x:Name="FechaLabel"
                               Text=""
                               FontSize="12"
                               TextColor="#B3E0F2FE" />
                    </VerticalStackLayout>

                    <Border Grid.Column="2"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="#1AFFFFFF"
                            Stroke="#33FFFFFF"
                            StrokeThickness="1"
                            Padding="10,6"
                            VerticalOptions="Center">
                        <HorizontalStackLayout Spacing="7">
                            <Image Source="ic_user_white.svg"
                                   WidthRequest="16"
                                   HeightRequest="16"
                                   Aspect="AspectFit"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Spacing="0">
                                <Label x:Name="UsuarioNombreLabel"
                                       Text=""
                                       FontFamily="OpenSansSemibold"
                                       FontSize="12"
                                       TextColor="{StaticResource TextOnBrand}" />
                                <Label x:Name="UsuarioRolLabel"
                                       Text=""
                                       FontSize="10"
                                       TextColor="#B3E0F2FE" />
                            </VerticalStackLayout>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- Indicadores del día -->
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="10,14">
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="TotalLabel" Text="0" Style="{StaticResource StatNumber}" />
                            <Label Text="Estudiantes" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}" Padding="10,14">
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="RegistradosLabel"
                                   Text="0"
                                   Style="{StaticResource StatNumber}"
                                   TextColor="{StaticResource SuccessDark}" />
                            <Label Text="Presentes hoy" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}" Padding="10,14">
                        <VerticalStackLayout Spacing="2">
                            <Label x:Name="PendientesLabel"
                                   Text="0"
                                   Style="{StaticResource StatNumber}"
                                   TextColor="{StaticResource WarningDark}" />
                            <Label Text="Pendientes" Style="{StaticResource StatCaption}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </Border>

        <!-- ================= Contenido ================= -->
        <CollectionView Grid.Row="1"
                        x:Name="EstudiantesCollectionView"
                        ItemsLayout="VerticalList"
                        Margin="16,16,16,0">

            <CollectionView.Header>
                <VerticalStackLayout Spacing="14">

                    <!-- Panel de búsqueda y filtros -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="14">
                            <HorizontalStackLayout Spacing="8">
                                <Image Source="ic_search_brand.svg"
                                       WidthRequest="18"
                                       HeightRequest="18"
                                       Aspect="AspectFit"
                                       VerticalOptions="Center" />
                                <Label Text="Buscar estudiantes" Style="{StaticResource SectionTitle}" />
                            </HorizontalStackLayout>

                            <!-- Selector de modo de búsqueda -->
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                <Button x:Name="BtnModoSimple"
                                        Text="Búsqueda simple"
                                        Style="{StaticResource BaseButton}"
                                        HeightRequest="44"
                                        Clicked="OnModoSimple" />
                                <Button x:Name="BtnModoAvanzada"
                                        Grid.Column="1"
                                        Text="Búsqueda avanzada"
                                        Style="{StaticResource OutlineButton}"
                                        HeightRequest="44"
                                        Clicked="OnModoAvanzada" />
                            </Grid>

                            <!-- ============ MODO SIMPLE ============ -->
                            <VerticalStackLayout x:Name="PanelSimple" Spacing="12">
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="NIVEL" Style="{StaticResource FieldLabel}" />
                                        <Border Style="{StaticResource InputField}">
                                            <Picker x:Name="NivelPickerS" Title="Seleccionar">
                                                <Picker.Items>
                                                    <x:String>Primaria</x:String>
                                                    <x:String>Secundaria</x:String>
                                                </Picker.Items>
                                            </Picker>
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                                        <Label Text="GRADO" Style="{StaticResource FieldLabel}" />
                                        <Border Style="{StaticResource InputField}">
                                            <Picker x:Name="GradoPickerS" Title="Seleccionar">
                                                <Picker.Items>
                                                    <x:String>1</x:String>
                                                    <x:String>2</x:String>
                                                    <x:String>3</x:String>
                                                    <x:String>4</x:String>
                                                    <x:String>5</x:String>
                                                    <x:String>6</x:String>
                                                </Picker.Items>
                                            </Picker>
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="5">
                                        <Label Text="SECCIÓN" Style="{StaticResource FieldLabel}" />
                                        <Border Style="{StaticResource InputField}">
                                            <Picker x:Name="SeccionPickerS" Title="Seleccionar">
                                                <Picker.Items>
                                                    <x:String>A</x:String>
                                                    <x:String>B</x:String>
                                                    <x:String>C</x:String>
                                                    <x:String>D</x:String>
                                                    <x:String>E</x:String>
                                                    <x:String>F</x:String>
                                                    <x:String>G</x:String>
                                                    <x:String>H</x:String>
                                                    <x:String>I</x:String>
                                                    <x:String>J</x:String>
                                                </Picker.Items>
                                            </Picker>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <Label Text="Filtra por nivel, grado y/o sección para ver a todos los estudiantes de esa aula."
                                       Style="{StaticResource CaptionText}"
                                       FontSize="11" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button Grid.Column="0"
                                            x:Name="BuscarBtn"
                                            Text="Buscar"
                                            Style="{StaticResource BaseButton}"
                                            Clicked="OnBuscarClicked" />
                                    <Button Grid.Column="1"
                                            x:Name="LimpiarBtn"
                                            Text="Limpiar"
                                            Style="{StaticResource OutlineButton}"
                                            Clicked="OnLimpiarClicked" />
                                </Grid>
                            </VerticalStackLayout>

                            <!-- ============ MODO AVANZADO ============ -->
                            <VerticalStackLayout x:Name="PanelAvanzada" Spacing="12" IsVisible="False">
                                <Border Style="{StaticResource InputField}">
                                    <Entry x:Name="NombreAvanzadoEntry"
                                           Placeholder="Nombre o apellidos (escribe para ver resultados)"
                                           ReturnType="Search"
                                           TextChanged="OnNombreAvanzadoChanged" />
                                </Border>

                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                                    <VerticalStackLayout Spacing="5">
                                        <Label Text="NIVEL" Style="{StaticResource FieldLabel}" />
                                        <Border Style="{StaticResource InputField}">
                                            <Picker x:Name="NivelPickerA" Title="Seleccionar">
                                                <Picker.Items>
                                                    <x:String>Primaria</x:String>
                                                    <x:String>Secundaria</x:String>
                                                </Picker.Items>
                                            </Picker>
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                                        <Label Text="GRADO" Style="{StaticResource FieldLabel}" />
                                        <Border Style="{StaticResource InputField}">
                                            <Picker x:Name="GradoPickerA" Title="Seleccionar">
                                                <Picker.Items>
                                                    <x:String>1</x:String>
                                                    <x:String>2</x:String>
                                                    <x:String>3</x:String>
                                                    <x:String>4</x:String>
                                                    <x:String>5</x:String>
                                                    <x:String>6</x:String>
                                                </Picker.Items>
                                            </Picker>
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Grid.Column="2" Spacing="5">
                                        <Label Text="SECCIÓN" Style="{StaticResource FieldLabel}" />
                                        <Border Style="{StaticResource InputField}">
                                            <Picker x:Name="SeccionPickerA" Title="Seleccionar">
                                                <Picker.Items>
                                                    <x:String>A</x:String>
                                                    <x:String>B</x:String>
                                                    <x:String>C</x:String>
                                                    <x:String>D</x:String>
                                                    <x:String>E</x:String>
                                                    <x:String>F</x:String>
                                                    <x:String>G</x:String>
                                                    <x:String>H</x:String>
                                                    <x:String>I</x:String>
                                                    <x:String>J</x:String>
                                                </Picker.Items>
                                            </Picker>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <Label x:Name="TurnoInfoLabel"
                                       Text=""
                                       Style="{StaticResource CaptionText}"
                                       FontSize="11" />

                                <Label Text="Los resultados se actualizan mientras escribes. Puedes combinar nombre con nivel, grado y sección."
                                       Style="{StaticResource CaptionText}"
                                       FontSize="11" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Acciones principales -->
                    <Grid ColumnDefinitions="2*,*" ColumnSpacing="10">
                        <Button Grid.Column="0"
                                x:Name="EscanerarQRBtn"
                                Text="Escanear código QR"
                                Style="{StaticResource BrandDarkButton}"
                                HeightRequest="52"
                                Clicked="OnEscanerarQRClicked" />
                        <Button Grid.Column="1"
                                x:Name="SalirBtn"
                                Text="Salir"
                                Style="{StaticResource DangerButton}"
                                HeightRequest="52"
                                Clicked="OnSalirClicked" />
                    </Grid>

                    <!-- Encabezado de resultados -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                        <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                            <Label Text="Resultados" Style="{StaticResource SectionTitle}" />
                            <Label x:Name="ResumenLabel"
                                   Text="Listado general"
                                   Style="{StaticResource CaptionText}"
                                   FontSize="12" />
                        </VerticalStackLayout>

                        <ActivityIndicator Grid.Column="1"
                                           x:Name="LoadingIndicator"
                                           IsRunning="False"
                                           IsVisible="False"
                                           WidthRequest="22"
                                           HeightRequest="22"
                                           VerticalOptions="Center" />

                        <Border Grid.Column="2" Style="{StaticResource Chip}" VerticalOptions="Center">
                            <Label x:Name="ConteoLabel" Text="0" Style="{StaticResource ChipLabel}" />
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ListCard}" Margin="0,0,0,10">
                        <Border.Shadow>
                            <Shadow Radius="14" Offset="0,4" Opacity="0.05" Brush="{StaticResource Brand900}" />
                        </Border.Shadow>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                            <Border Grid.Column="0" Style="{StaticResource Avatar}">
                                <Label Text="{Binding Iniciales}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{StaticResource PrimaryDark}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label Text="{Binding NombreCompleto}" Style="{StaticResource ItemTitle}" />
                                <Label Text="{Binding InfoClase}" Style="{StaticResource CaptionText}" />
                                <Border Style="{StaticResource Chip}" Margin="0,4,0,0" HorizontalOptions="Start">
                                    <Label Text="{Binding CodigoLabel}" Style="{StaticResource ChipLabel}" />
                                </Border>
                            </VerticalStackLayout>

                            <Border Grid.Column="2"
                                    Style="{StaticResource StatusPill}"
                                    BackgroundColor="{StaticResource SuccessDark}"
                                    Stroke="{StaticResource Success}"
                                    WidthRequest="52"
                                    Padding="0"
                                    IsVisible="{Binding RegistrarHabilitado}">
                                <ImageButton Source="ic_check_white.svg"
                                             WidthRequest="22"
                                             HeightRequest="22"
                                             MinimumWidthRequest="0"
                                             MinimumHeightRequest="0"
                                             Padding="0"
                                             Aspect="AspectFit"
                                             BackgroundColor="Transparent"
                                             SemanticProperties.Description="Registrar asistencia"
                                             Clicked="OnRegistrarAsistenciaClicked"
                                             CommandParameter="{Binding}" />
                            </Border>

                            <Border Grid.Column="2"
                                    Style="{StaticResource ChipSuccess}"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding YaRegistrado}">
                                <Label Text="Presente hoy"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="11"
                                       TextColor="{StaticResource SuccessDark}" />
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.EmptyView>
                <VerticalStackLayout Spacing="10"
                                     Padding="20,40"
                                     HorizontalOptions="Center"
                                     VerticalOptions="Center">
                    <Image Source="ic_no_results_muted.svg"
                           WidthRequest="42"
                           HeightRequest="42"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label Text="Sin resultados"
                           Style="{StaticResource SectionTitle}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Ajusta el nombre o los filtros y vuelve a buscar."
                           Style="{StaticResource CaptionText}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
