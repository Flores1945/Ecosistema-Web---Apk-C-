<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiAppAsistencia.MainPage"
             Title="Toma de Asistencia">
    <Grid RowDefinitions="Auto, Auto, *" Padding="20">
        <VerticalStackLayout Grid.Row="0" Spacing="15">
            <Label Text="🏫 I.E. Liceo Trujillo"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryDark}" />

            <Label x:Name="UsuarioLabel"
                   Text=""
                   FontSize="14"
                   TextColor="{StaticResource Gray600}" />

            <BoxView HeightRequest="1"
                     Color="{StaticResource Gray200}" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
               BackgroundColor="{StaticResource White}"
               Stroke="{StaticResource Gray200}"
               StrokeThickness="1"
               StrokeShape="RoundRectangle 12"
               Padding="15"
               Margin="0,10">
            <Border.Shadow>
                <Shadow Radius="10" Opacity="0.1" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="10">
                <Label Text="🔍 Buscar Estudiantes"
                       FontSize="16"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryDark}" />

                <Entry x:Name="NombreEntry"
                       Placeholder="Nombre del estudiante"
                       TextColor="{StaticResource OffBlack}"
                       PlaceholderColor="{StaticResource Gray500}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Picker x:Name="NivelPicker"
                            Grid.Column="0"
                            Title="Nivel"
                            TitleColor="{StaticResource Gray500}">
                        <Picker.Items>
                            <x:String></x:String>
                            <x:String>Primaria</x:String>
                            <x:String>Secundaria</x:String>
                        </Picker.Items>
                    </Picker>

                    <Picker x:Name="TurnoPicker"
                            Grid.Column="1"
                            Title="Turno"
                            TitleColor="{StaticResource Gray500}">
                        <Picker.Items>
                            <x:String></x:String>
                            <x:String>Mañana</x:String>
                            <x:String>Tarde</x:String>
                        </Picker.Items>
                    </Picker>
                </Grid>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Picker x:Name="GradoPicker"
                            Grid.Column="0"
                            Title="Grado"
                            TitleColor="{StaticResource Gray500}">
                        <Picker.Items>
                            <x:String></x:String>
                            <x:String>1</x:String>
                            <x:String>2</x:String>
                            <x:String>3</x:String>
                            <x:String>4</x:String>
                            <x:String>5</x:String>
                            <x:String>6</x:String>
                        </Picker.Items>
                    </Picker>

                    <Picker x:Name="SeccionPicker"
                            Grid.Column="1"
                            Title="Sección"
                            TitleColor="{StaticResource Gray500}">
                        <Picker.Items>
                            <x:String></x:String>
                            <x:String>A</x:String>
                            <x:String>B</x:String>
                            <x:String>C</x:String>
                            <x:String>D</x:String>
                            <x:String>E</x:String>
                            <x:String>F</x:String>
                            <x:String>G</x:String>
                            <x:String>H</x:String>
                            <x:String>I</x:String>
                            <x:String>J</x:String>
                            <x:String>K</x:String>
                            <x:String>L</x:String>
                            <x:String>M</x:String>
                            <x:String>N</x:String>
                            <x:String>O</x:String>
                        </Picker.Items>
                    </Picker>
                </Grid>

                <Button x:Name="BuscarBtn"
                        Text="Buscar"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        Clicked="OnBuscarClicked" />
            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="10">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button x:Name="EscanerarQRBtn"
                        Grid.Column="0"
                        Text="📷 Escanear QR"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        Clicked="OnEscanerarQRClicked" />

                <Button x:Name="SalirBtn"
                        Grid.Column="1"
                        Text="Cerrar Sesión"
                        BackgroundColor="{StaticResource Error}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        CornerRadius="8"
                        Clicked="OnSalirClicked" />
            </Grid>

            <Label Text="Resultados de Búsqueda"
                   FontSize="16"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryDark}"
                   Margin="0,10,0,5" />

            <Border BackgroundColor="{StaticResource White}"
                   Stroke="{StaticResource Gray200}"
                   StrokeThickness="1"
                   StrokeShape="RoundRectangle 12"
                   Padding="0"
                   VerticalOptions="FillAndExpand">
                <Border.Shadow>
                    <Shadow Radius="10" Opacity="0.1" />
                </Border.Shadow>
                <CollectionView x:Name="EstudiantesCollectionView"
                                EmptyView="No se encontraron estudiantes">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border BackgroundColor="{StaticResource White}"
                                   Stroke="{StaticResource Gray200}"
                                   StrokeThickness="1"
                                   StrokeShape="RoundRectangle 8"
                                   Padding="15"
                                   Margin="5">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                                        <Label Text="{Binding NombreCompleto}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource PrimaryDark}" />
                                        <Label Text="{Binding InfoClase}"
                                               FontSize="12"
                                               TextColor="{StaticResource Gray600}" />
                                        <Label Text="{Binding CodigoQR}"
                                               FontSize="11"
                                               TextColor="{StaticResource Gray500}" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1"
                                            Text="✓"
                                            FontSize="18"
                                            BackgroundColor="{StaticResource Success}"
                                            TextColor="{StaticResource White}"
                                            CornerRadius="20"
                                            WidthRequest="50"
                                            HeightRequest="50"
                                            Clicked="OnRegistrarAsistenciaClicked"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
