<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:camera="clr-namespace:Microsoft.Maui.Controls.Maps;assembly=Microsoft.Maui.Controls"
             x:Class="MiAppAsistencia.Views.CameraBarcodeReaderPage"
             Title="Escanear QR">
    <Grid RowDefinitions="*,Auto">
        <VerticalStackLayout Grid.Row="0"
                             Padding="20"
                             Spacing="20"
                             VerticalOptions="Center">
            <Label Text="📷"
                   FontSize="80"
                   HorizontalTextAlignment="Center" />

            <Label Text="Escanear Código QR"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="{StaticResource PrimaryDark}"
                   HorizontalTextAlignment="Center" />

            <Label Text="Ingrese el código QR manualmente:"
                   FontSize="14"
                   TextColor="{StaticResource Gray600}"
                   HorizontalTextAlignment="Center" />

            <Entry x:Name="CodigoQREntry"
                   Placeholder="Código QR (ej: EST-001)"
                   TextColor="{StaticResource OffBlack}"
                   PlaceholderColor="{StaticResource Gray500}"
                   HorizontalTextAlignment="Center" />

            <Button x:Name="ValidarBtn"
                    Text="Validar Código"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="{StaticResource White}"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    Clicked="OnValidarClicked" />
        </VerticalStackLayout>

        <Border Grid.Row="1"
               BackgroundColor="{StaticResource PrimaryDark}"
               Padding="20"
               StrokeShape="Rectangle">
            <Label Text="Nota: La funcionalidad de cámara requiere instalación de librerías adicionales"
                   TextColor="{StaticResource White}"
                   FontSize="12"
                   HorizontalTextAlignment="Center" />
        </Border>
    </Grid>
</ContentPage>
