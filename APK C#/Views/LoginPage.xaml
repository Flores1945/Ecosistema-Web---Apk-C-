<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiAppAsistencia.Views.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource PageBackground}">

    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Encabezado de marca -->
            <Border Background="{StaticResource BrandGradient}"
                    StrokeShape="RoundRectangle 0,0,28,28"
                    StrokeThickness="0"
                    Padding="24,34,24,60">
                <VerticalStackLayout Spacing="14">
                    <Border WidthRequest="56"
                            HeightRequest="56"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#26FFFFFF"
                            Stroke="#40FFFFFF"
                            StrokeThickness="1"
                            Padding="12"
                            HorizontalOptions="Start">
                        <Image Source="ic_school_white.svg"
                               Aspect="AspectFit"
                               SemanticProperties.Description="Logotipo institucional" />
                    </Border>

                    <Label Text="I.E. LICEO TRUJILLO"
                           Style="{StaticResource OverlineOnBrand}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Control de Asistencia"
                               FontFamily="OpenSansSemibold"
                               FontSize="26"
                               LineHeight="1.05"
                               TextColor="{StaticResource TextOnBrand}" />
                        <Label Text="Registro digital para docentes y dirección"
                               Style="{StaticResource BodyText}"
                               TextColor="#CCE0F2FE" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Formulario -->
            <Border Style="{StaticResource Card}"
                    Margin="20,-40,20,0"
                    Padding="22,24">
                <Border.Shadow>
                    <Shadow Radius="24" Offset="0,10" Opacity="0.10" Brush="{StaticResource Brand900}" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Bienvenido" Style="{StaticResource PageTitle}" />
                        <Label Text="Ingresa con las credenciales de tu cuenta institucional."
                               Style="{StaticResource CaptionText}" />
                    </VerticalStackLayout>

                    <!-- Banner de error -->
                    <Border x:Name="ErrorBanner"
                            IsVisible="False"
                            BackgroundColor="{StaticResource DangerLight}"
                            Stroke="{StaticResource Danger}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,10">
                        <Label x:Name="EstadoLabel"
                               Text=""
                               FontFamily="OpenSansSemibold"
                               FontSize="13"
                               TextColor="{StaticResource DangerDark}" />
                    </Border>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="CORREO ELECTRÓNICO" Style="{StaticResource FieldLabel}" />
                        <Border x:Name="CorreoField" Style="{StaticResource InputField}">
                            <Entry x:Name="CorreoEntry"
                                   Placeholder="nombre@liceo.edu"
                                   Keyboard="Email"
                                   ReturnType="Next"
                                   SemanticProperties.Hint="Correo institucional" />
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="CONTRASEÑA" Style="{StaticResource FieldLabel}" />
                        <Border x:Name="ContrasenaField" Style="{StaticResource InputField}">
                            <Entry x:Name="ContrasenaEntry"
                                   Placeholder="••••••••"
                                   IsPassword="True"
                                   ReturnType="Go"
                                   Completed="OnLoginClicked"
                                   SemanticProperties.Hint="Contraseña" />
                        </Border>
                    </VerticalStackLayout>

                    <Button x:Name="LoginBtn"
                            Text="Iniciar Sesión"
                            Style="{StaticResource BaseButton}"
                            HeightRequest="52"
                            Clicked="OnLoginClicked" />

                    <VerticalStackLayout Spacing="3">
                        <Label Text="Acceso restringido a personal autorizado."
                               Style="{StaticResource CaptionText}"
                               FontSize="12"
                               HorizontalTextAlignment="Center" />
                        <Label Text="¿No tienes cuenta? Solicítala a la dirección del colegio."
                               Style="{StaticResource CaptionText}"
                               FontSize="12"
                               TextColor="{StaticResource Primary}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Pie -->
            <VerticalStackLayout Spacing="2" Padding="24,20,24,28">
                <Label Text="Sistema de Asistencia · v1.0"
                       Style="{StaticResource CaptionText}"
                       HorizontalTextAlignment="Center" />
                <Label Text="I.E. Liceo Trujillo — Trujillo, Perú"
                       Style="{StaticResource CaptionText}"
                       FontSize="11"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
