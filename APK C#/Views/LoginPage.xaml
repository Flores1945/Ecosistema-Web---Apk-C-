<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiAppAsistencia.Views.LoginPage"
             BackgroundColor="{StaticResource Gray100}">
    <Grid RowDefinitions="Auto, *" Padding="20">
        <Frame Grid.Row="1"
               BackgroundColor="{StaticResource White}"
               CornerRadius="20"
               Padding="30"
               HasShadow="True"
               VerticalOptions="Center"
               HorizontalOptions="Center"
               WidthRequest="400">
            <VerticalStackLayout Spacing="20">
                <Label Text="🏫"
                       FontSize="60"
                       HorizontalTextAlignment="Center" />

                <Label Text="I.E. Liceo Trujillo"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource PrimaryDark}"
                       HorizontalTextAlignment="Center" />

                <Label Text="Control de Asistencia Institucional"
                       FontSize="14"
                       TextColor="{StaticResource Gray600}"
                       HorizontalTextAlignment="Center" />

                <BoxView HeightRequest="1"
                         Color="{StaticResource Gray200}"
                         Margin="0,10" />

                <Label Text="Correo Electrónico"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OffBlack}" />

                <Entry x:Name="CorreoEntry"
                       Placeholder="Ingresa tu correo"
                       Keyboard="Email"
                       TextColor="{StaticResource OffBlack}"
                       PlaceholderColor="{StaticResource Gray500}" />

                <Label Text="Contraseña"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{StaticResource OffBlack}" />

                <Entry x:Name="ContrasenaEntry"
                       Placeholder="Ingresa tu contraseña"
                       IsPassword="True"
                       TextColor="{StaticResource OffBlack}"
                       PlaceholderColor="{StaticResource Gray500}" />

                <Button x:Name="LoginBtn"
                        Text="Iniciar Sesión"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource White}"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnLoginClicked" />

                <Label x:Name="EstadoLabel"
                       Text=""
                       FontSize="12"
                       TextColor="{StaticResource Error}"
                       HorizontalTextAlignment="Center"
                       IsVisible="False" />

                <Label Text="¿No tienes cuenta? Solicítala a la dirección del colegio."
                       FontSize="12"
                       TextColor="{StaticResource Gray600}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
